APP_NAME="Invierte Express"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://web_invierte.test

# Orígenes separados por coma (Herd: añadir https://web_invierte.test)
CORS_ORIGIN=http://web_invierte.test,https://web_invierte.test
SANCTUM_STATEFUL_DOMAINS=web_invierte.test

WEB_API_BASE_URL=https://inmopro.laravel.cloud
WEB_API_TIPO_WEB=invierteexpress.pe
WEB_API_TIMEOUT_MS=15000

ADMIN_EMAIL=admin@invierteexpress.pe
ADMIN_PASSWORD=admin123

APP_LOCALE=es
APP_FALLBACK_LOCALE=es
APP_FAKER_LOCALE=es_PE

APP_MAINTENANCE_DRIVER=file

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=web_invierte
DB_USERNAME=root
DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=public
QUEUE_CONNECTION=database

CACHE_STORE=database

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="informes@invierteexpress.pe"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"
VITE_API_URL=/api
VITE_AUTH_STORAGE_KEY=invierte_auth_token
VITE_AUTH_EMAIL_KEY=invierte_admin_email
VITE_THEME_STORAGE_KEY=invierte_theme
